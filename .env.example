# Vocal Bridge (required for voice)
# Prefer an *agent-scoped* key from the agent's page (Developer Mode → API Keys).
# Account-level keys also need VOCAL_BRIDGE_AGENT_ID (sent as X-Agent-Id).
VOCAL_BRIDGE_API_KEY=vb_your_api_key_here
VOCAL_BRIDGE_AGENT_ID=your-agent-uuid-here
# Outbound dial target for sample/demo "Call traveler"
DEMO_TRAVELER_PHONE=+12099981960

# Landing AI ADE Parse + Extract (optional — demo fallback if unset)
LANDING_AI_API_KEY=
LANDING_AI_API_BASE=https://api.va.landing.ai
LANDING_AI_PARSE_MODEL=dpt-2-latest
LANDING_AI_EXTRACT_MODEL=extract-latest

# Sabre CERT (optional — demo Bargain Finder / exchange if unset)
# Prefer a short-lived access token, or client credentials to mint one.
SABRE_ACCESS_TOKEN=
SABRE_CLIENT_ID=
SABRE_CLIENT_SECRET=
SABRE_API_BASE=https://api.cert.platform.sabre.com

# PayPal Orders v2 Sandbox (optional — demo capture if unset)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000
PAYPAL_CANCEL_URL=http://localhost:3000
